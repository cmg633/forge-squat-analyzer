# Environment Variables — Names Only, No Secrets
# Copy this file to .env and fill in values

# --- LLM API Keys (optional — backend falls back to template coaching) ---
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Backend Config ---
UPLOAD_DIR=/tmp/forge_uploads
OUTPUT_DIR=/tmp/forge_outputs
MAX_FILE_MB=100
PORT=7860
FRONTEND_URL=https://your-app.vercel.app

# --- Frontend (optional profile links; API calls use relative /api) ---
VITE_GITHUB_URL=https://github.com/chiranth-mg
VITE_LINKEDIN_URL=https://linkedin.com/in/chiranth-mg


